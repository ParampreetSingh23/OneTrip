# Neon (pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooler) host, used by prisma migrate
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 (private bucket; API token with Object Read & Write on this bucket only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="onetrip-photos"

# openssl rand -base64 48  (auth sessions, unlock cookies, share-link encryption)
APP_SECRET=""

# Public URL of the app (auth callbacks)
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# openssl rand -hex 24  (Vercel Cron sends it as Bearer token)
CRON_SECRET=""

# Optional limits
# MAX_FILES=500
# MAX_FILE_MB=50
# MAX_ALBUM_MB=5000
